Troubleshooting CP issue.
#=========================
chmod 755 /usr/local/libexec/linoop/skel-copy
chown root:root /usr/local/libexec/linoop/skel-copy
/usr/bin/chmod 755 /usr/local/libexec/linoop/skel-copy
/usr/bin/chown root:root /usr/local/libexec/linoop/skel-copy
/usr/bin/tee /usr/local/bin/linoop-skel-copy > /dev/null <<'EOF'
#!/bin/bash
exec /usr/local/libexec/linoop/skel-copy "$@"
EOF

 /usr/bin/chmod 755 /usr/local/bin/linoop-skel-copy
 /usr/bin/chown root:root /usr/local/bin/linoop-skel-copy
 ls -l /usr/local/bin/linoop-skel-copy
 visudo /etc/sudoers.d/linoop-account-mgt
visudo -c

REGULAR USER WILL USE COMMAND TO COPY SKEL FILES
===========================================================
sudo /usr/local/bin/linoop-skel-copy /home/newuser

